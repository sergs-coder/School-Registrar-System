# Copy to .env and adjust. Every setting has a safe development default.
ENVIRONMENT=development
# SQLite for local dev; Docker Compose uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg://srm:srm@db:5432/srm
DATABASE_URL=sqlite:///./srm.db

# CHANGE THESE in production (python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# Fernet key for encrypting uploads (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FILE_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=5

# Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=TUA Registrar <registrar@tua.edu.ph>
